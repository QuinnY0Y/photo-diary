{
  "name": "photo-diary",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:ci": "expo start --web --non-interactive",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && expo install --check",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@noble/hashes": "^2.3.0",
    "expo": "~57.0.14",
    "expo-camera": "~57.0.3",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-image-manipulator": "~57.0.11",
    "expo-image-picker": "~57.0.11",
    "expo-location": "~57.0.11",
    "expo-notifications": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.13",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
